# copy this to backend/.env and fill in what you need
# real env vars (shell or docker) win over this file
JOB_DATA_DIR=data

# sign in password, leave empty to skip sign in
# make a hash with: python -m job_backend.auth.hash_password
JOB_AUTH_PASSWORD_HASH=

# postgres, make a password with:
# python -c "import secrets; print(secrets.token_hex(32))"
JOB_POSTGRES_PASSWORD=
JOB_DATABASE_URL=postgresql://intern_radar:${JOB_POSTGRES_PASSWORD}@127.0.0.1:5432/intern_radar

JOB_LOG_LEVEL=INFO

# ai, any openai compatible endpoint works (openai, openrouter, ollama, lm studio...)
JOB_AI_BASE_URL=https://api.openai.com/v1
JOB_AI_MODEL=gpt-6-luna
# JOB_AI_API_KEY=
# chat_completions works everywhere, responses is openai only but streams reasoning
# JOB_AI_API=responses
# none, minimal, low, medium, high, xhigh or max
# JOB_AI_REASONING_EFFORT=medium

# pdf export needs tectonic
JOB_LATEX_EXECUTABLE=tectonic

# scraping, auto uses plain http and falls back to a headless browser
JOB_PAGE_RENDERER=auto
# run "python -m playwright install chromium" or point at a browser you already have
# JOB_BROWSER_EXECUTABLE=/absolute/path/to/chromium
# false shows the browser window, one page at a time, for debugging a page on your desktop.
# scheduled runs stay headless, and either way the browser's user agent names this app
# JOB_BROWSER_HEADLESS=true
# seconds between requests to the same site, for manual and scheduled scrapes
# JOB_CRON_DELAY_MIN_SECONDS=2
# JOB_CRON_DELAY_MAX_SECONDS=5
# JOB_WORKER_CONFIG_FILE=/absolute/path/to/schedules.json

# discord, all optional
# errors and warnings
# JOB_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
# live scrape progress and the daily health report
# JOB_DISCORD_SCRAPE_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
# one message a day with the new jobs
# JOB_DISCORD_DAILY_JOBS_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
# a bot token adds page buttons and a sort menu to the daily message
# JOB_DISCORD_BOT_TOKEN=BOT_TOKEN
# JOB_DISCORD_DAILY_JOBS_CHANNEL_ID=123456789012345678

# job matching runs on the cpu, compose.gpu.yaml sets this to the gpu sidecar
# JOB_EMBEDDER_URL=http://embedder:8100
# JOB_EMBEDDER_IMAGE=intern-radar-embedder:local
