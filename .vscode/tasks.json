{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend: start",
      "type": "npm",
      "script": "start",
      "path": "frontend",
      "isBackground": true,
      "problemMatcher": {
        "base": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building|Changes detected",
          "endsPattern": "Local:.*http://localhost:4200"
        }
      }
    },
    {
      "label": "Frontend: check",
      "type": "npm",
      "script": "check",
      "path": "frontend",
      "problemMatcher": []
    },
    {
      "label": "Backend: lint",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "ruff", "check", "."],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Backend: format check",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "ruff", "format", "--check", "."],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Backend: typecheck",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pyright"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Backend: test",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Backend: check",
      "dependsOn": [
        "Backend: lint",
        "Backend: format check",
        "Backend: typecheck",
        "Backend: test"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Check all",
      "dependsOn": ["Frontend: check", "Backend: check"],
      "dependsOrder": "sequence",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
