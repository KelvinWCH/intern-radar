{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend: Angular",
      "type": "pwa-chrome",
      "request": "launch",
      "preLaunchTask": "Frontend: start",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/frontend"
    },
    {
      "name": "Backend: FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["job_backend.main:app", "--reload"],
      "cwd": "${workspaceFolder}/backend",
      "jinja": false
    }
  ]
}
